# Browserbase cloud credentials (from https://browserbase.com)
# Required for running cloud browser sessions
BROWSERBASE_API_KEY=bb_live_your_api_key_here
BROWSERBASE_PROJECT_ID=your_project_id_here

# Ollama local open-weight model configuration
# Gemma runs locally through Ollama; page text never leaves your machine
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ntfy push notification topic (https://ntfy.sh)
# Choose a hard-to-guess topic name to receive alerts on your phone
NTFY_TOPIC=slothwatch-your-unique-topic
NTFY_SERVER=https://ntfy.sh

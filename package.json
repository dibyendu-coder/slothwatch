{
  "name": "slothwatch",
  "version": "0.1.0",
  "description": "A lazy web-chore watcher powered by Browserbase, local Gemma via Ollama, and ntfy",
  "type": "module",
  "bin": {
    "slothwatch": "./dist/bin/slothwatch.js"
  },
  "scripts": {
    "dev": "tsx bin/slothwatch.ts",
    "build": "tsc",
    "start": "node dist/bin/slothwatch.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx bin/slothwatch.ts doctor",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.3.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "picocolors": "^1.1.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
